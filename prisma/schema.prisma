generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // 台股券商手續費折扣係數，1.0 = 無折扣，0.6 = 6 折，0.28 = 2.8 折，僅作用於台股
  commissionDiscount Float @default(1)
  // 新增交易時的檢查清單，JSON 陣列格式儲存字串清單
  tradeChecklist     String?
  accounts      Account[]
  sessions      Session[]
  trades        Trade[]
  positionLots  PositionLot[]
  memos         Memo[]
  watchlists    Watchlist[]
  watchlistItems WatchlistItem[]
  observationTargets ObservationTarget[]
  stopLossAdjustments StopLossAdjustment[]
  wallets       Wallet[]
  walletTransactions WalletTransaction[]
  coveredCallPositions CoveredCallPosition[]
  coveredCallLegs      CoveredCallLeg[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trade {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  symbol         String
  symbolName     String?
  market         String
  currency       String   @default("TWD")
  side           String
  tradeDate      DateTime
  settlementDate DateTime?

  lotType        String
  lots           Int?
  shares         Float
  price          Float

  commission     Float
  transactionTax Float
  totalFees      Float
  grossAmount    Float
  netAmount      Float

  realizedPnL    Float?
  isETF          Boolean  @default(false)

  stopLoss       Float?
  notes          String?
  tags           String?

  userId         String?
  user           User?    @relation(fields: [userId], references: [id])

  positionLots   PositionLot[]
  memos          Memo[]

  @@index([symbol])
  @@index([tradeDate])
  @@index([userId])
}

model PositionLot {
  id           String   @id @default(cuid())
  symbol       String
  market       String
  currency     String   @default("TWD")
  lotType      String
  openTradeId  String
  openTrade    Trade    @relation(fields: [openTradeId], references: [id], onDelete: Cascade)
  openDate     DateTime
  shares       Float
  costPerShare Float
  isOpen       Boolean  @default(true)

  userId       String?
  user         User?    @relation(fields: [userId], references: [id])

  @@index([symbol, isOpen])
  @@index([userId])
}

model Memo {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  content      String
  tags         String?

  linkedSymbol String?
  tradeId      String?
  trade        Trade?   @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  pinned       Boolean  @default(false)

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([linkedSymbol])
  @@index([tradeId])
}

model Watchlist {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  description String?
  sortOrder   Int      @default(0)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  items       WatchlistItem[]

  @@index([userId, sortOrder])
}

model WatchlistItem {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  symbol      String
  symbolName  String?
  market      String
  note        String?
  sortOrder   Int      @default(0)

  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@index([userId])
  @@index([symbol])
}

model ObservationTarget {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  symbol          String
  symbolName      String?
  market          String
  currency        String   @default("TWD")

  // 自由文字確認筆記
  note            String?
  // 最後一次「今日已確認」的台北日期（YYYY-MM-DD），null = 從未確認
  lastCheckedDate String?
  archived        Boolean  @default(false)
  sortOrder       Int      @default(0)

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, market])
  @@index([userId, archived])
}

// 現金錢包：每位使用者每種幣別（TWD/USD）各一個獨立錢包，記錄可動用現金餘額
model Wallet {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  currency     String   // "TWD" | "USD"
  balance      Float    @default(0)

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions WalletTransaction[]

  @@unique([userId, currency])
  @@index([userId])
}

// 錢包異動帳本：記錄每一筆儲值、提領、買入扣款、賣出入帳與回沖
model WalletTransaction {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())

  currency     String
  // "DEPOSIT" | "WITHDRAW" | "TRADE_BUY" | "TRADE_SELL" | "REVERSAL"
  type         String
  // 帶正負號：儲值/賣出入帳為正、提領/買入扣款為負
  amount       Float
  // 異動後餘額（稽核用）
  balanceAfter Float
  // 連結 Trade（買/賣異動用）；不設外鍵，避免刪交易時連動帳本
  tradeId      String?
  note         String?

  walletId     String
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, currency, createdAt])
  @@index([tradeId])
}

// 停損調整記錄：每次在持倉分析頁調整某部位停損價時留下一筆歷史，附帶一段筆記
model StopLossAdjustment {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())

  symbol           String
  market           String

  // 調整前 / 後的停損價，null 代表「未設定」（首次設定或清除）
  previousStopLoss Float?
  newStopLoss      Float?

  // 此次調整的筆記（為何調整、依據）
  note             String?

  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol, createdAt])
}

// 掩護性買權（Covered Call）底倉：持有的買進買權（long call）或現股，
// 之後可持續對其賣出 Call 收權利金，組成 covered call / diagonal 結構。
model CoveredCallPosition {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  symbol             String
  symbolName         String?
  market             String
  currency           String   @default("TWD")

  // 底倉型態："LONG_CALL"（買進買權）| "STOCK"（現股）
  underlyingType     String   @default("LONG_CALL")
  // 契約乘數：每 1 點（或每 1 元）權利金對應的金額。
  // 台股股票選擇權 = 2000 股/口；台指選擇權 = 50 元/點；現股一張 = 1000 股
  contractMultiplier Float    @default(2000)

  // 底倉數量（口數或張數）與建立成本
  quantity           Float
  openDate           DateTime
  openPrice          Float
  openFee            Float    @default(0)

  // long call 的履約價與到期日；現股底倉可留空
  strike             Float?
  expiry             DateTime?

  // "OPEN" | "CLOSED"
  status             String   @default("OPEN")
  closeDate          DateTime?
  closePrice         Float?
  closeFee           Float?

  notes              String?

  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  legs               CoveredCallLeg[]

  @@index([userId, status])
  @@index([userId, symbol])
}

// 對底倉賣出的每一口 Call（sell call）記錄：開倉收權利金，之後買回／到期／被指派／轉倉平倉。
model CoveredCallLeg {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  positionId   String
  position     CoveredCallPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  strike       Float
  expiry       DateTime
  contracts    Float
  openDate     DateTime
  openPremium  Float
  openFee      Float    @default(0)

  // "OPEN" | "BOUGHT_BACK"（買回平倉）| "EXPIRED"（到期歸零）| "ASSIGNED"（被指派）| "ROLLED"（轉倉）
  status       String   @default("OPEN")
  closeDate    DateTime?
  // 平倉權利金；到期歸零為 0，被指派時填結算價值
  closePremium Float?
  closeFee     Float?

  // 轉倉來源：本腿由哪一腿 roll 而來
  rolledFromId String?

  notes        String?

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([positionId, status])
  @@index([userId, openDate])
}
