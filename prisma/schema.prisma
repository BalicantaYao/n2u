generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // 台股券商手續費折扣係數，1.0 = 無折扣，0.6 = 6 折，0.28 = 2.8 折，僅作用於台股
  commissionDiscount Float @default(1)
  accounts      Account[]
  sessions      Session[]
  trades        Trade[]
  positionLots  PositionLot[]
  memos         Memo[]
  watchlists    Watchlist[]
  watchlistItems WatchlistItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trade {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  symbol         String
  symbolName     String?
  market         String
  currency       String   @default("TWD")
  side           String
  tradeDate      DateTime
  settlementDate DateTime?

  lotType        String
  lots           Int?
  shares         Float
  price          Float

  commission     Float
  transactionTax Float
  totalFees      Float
  grossAmount    Float
  netAmount      Float

  realizedPnL    Float?
  isETF          Boolean  @default(false)

  stopLoss       Float?
  notes          String?
  tags           String?

  userId         String?
  user           User?    @relation(fields: [userId], references: [id])

  positionLots   PositionLot[]
  memos          Memo[]

  @@index([symbol])
  @@index([tradeDate])
  @@index([userId])
}

model PositionLot {
  id           String   @id @default(cuid())
  symbol       String
  market       String
  currency     String   @default("TWD")
  lotType      String
  openTradeId  String
  openTrade    Trade    @relation(fields: [openTradeId], references: [id], onDelete: Cascade)
  openDate     DateTime
  shares       Float
  costPerShare Float
  isOpen       Boolean  @default(true)

  userId       String?
  user         User?    @relation(fields: [userId], references: [id])

  @@index([symbol, isOpen])
  @@index([userId])
}

model Memo {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  content      String
  tags         String?

  linkedSymbol String?
  tradeId      String?
  trade        Trade?   @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  pinned       Boolean  @default(false)

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([linkedSymbol])
  @@index([tradeId])
}

model Watchlist {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  description String?
  sortOrder   Int      @default(0)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  items       WatchlistItem[]

  @@index([userId, sortOrder])
}

model WatchlistItem {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  symbol      String
  symbolName  String?
  market      String
  note        String?
  sortOrder   Int      @default(0)

  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@index([userId])
  @@index([symbol])
}

// 主動式 ETF 每日持股快照。fundSymbol 對應 src/lib/etf-holdings/issuers.ts
// 內登記的 ETF 代碼（例：00980A）。一檔 ETF 每個交易日一份快照。
model EtfHoldingSnapshot {
  id          String   @id @default(cuid())
  fundSymbol  String
  asOfDate    DateTime @db.Date
  fetchedAt   DateTime @default(now())
  // PCF 中常見的整體數值（若資料源未提供則為 null）
  nav         Float?
  totalAssets Float?
  // 來源 URL 或 issuer 代碼，方便日後追溯
  source      String?

  holdings    EtfHolding[]

  @@unique([fundSymbol, asOfDate])
  @@index([fundSymbol, asOfDate])
}

model EtfHolding {
  id          String   @id @default(cuid())
  snapshotId  String
  snapshot    EtfHoldingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  symbol      String
  name        String
  market      String?
  shares      Float
  // 占基金比重（小數，0.0567 = 5.67%）
  weight      Float?
  marketValue Float?
  price       Float?

  @@index([snapshotId])
  @@index([symbol])
}
